---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reaction Rush</title>
    <meta name="description" content="Train your reaction speed." />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
    </header>
    <div id="surface" aria-hidden="true"></div>
    <div id="hud">
      <h1 id="title">Reaction Rush</h1>
      <p id="subtitle">Train your reaction speed</p>
      <p id="score">0 / 10</p>
      <p id="state" aria-live="polite">GREEN — GO</p>
    </div>
    <main>
      <button id="action" type="button" autofocus aria-label="Reaction Rush"></button>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>

